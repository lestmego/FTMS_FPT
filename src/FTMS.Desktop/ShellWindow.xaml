<Window x:Class="FTMS.Desktop.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FTMS Companion" Width="1500" Height="920" MinWidth="1100" MinHeight="760" Background="#F5F5F7" FontFamily="Segoe UI Variable Display"
        PreviewMouseMove="OnUserActivity" PreviewKeyDown="OnUserActivity">
    <Window.Resources>
        <Style x:Key="CommandButton" TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#F7F9F7"/><Setter Property="Foreground" Value="#263631"/><Setter Property="BorderBrush" Value="#CBD4D0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="154"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Background="#FBFBFD" BorderBrush="#E3E3E6" BorderThickness="0,0,0,1">
            <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#1D1D1F" CornerRadius="9"><TextBlock Text="F" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Margin="13,0,0,0"><TextBlock Text="FTMS Companion" FontSize="19" FontWeight="SemiBold" Foreground="#1D1D1F"/><TextBlock Text="Ticket operations" FontSize="11" Foreground="#86868B"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Style="{StaticResource CommandButton}" Content="Trang FTMS" Click="OpenFtms"/><Button Style="{StaticResource CommandButton}" Content="Dang nhap lai" Click="RecoverLogin"/><Button Style="{StaticResource CommandButton}" Content="Tai lai" Click="ReloadFtms"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,7" Margin="0,0,10,0" Background="#E4ECE8" CornerRadius="4"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D9A441" Margin="0,0,8,0"/><TextBlock x:Name="SessionText" Text="Dang ket noi" Foreground="#42544E"/></StackPanel></Border>
                    <Button Width="42" Height="42" ToolTip="Cau hinh" Click="OpenSettings" Background="#1D1D1F" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="18" Content="⚙"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,14,16,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="20" Background="#1D1D1F" CornerRadius="12"><StackPanel><TextBlock Text="Tong ticket" Foreground="#AEAEB2" FontSize="12"/><TextBlock x:Name="TotalValue" Text="0" Foreground="White" FontSize="36" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Du lieu dang theo doi" Foreground="#6E6E73" FontSize="11"/></StackPanel></Border>
            <Border Grid.Column="1" Margin="8,0" Padding="18" Background="#FFFFFF" BorderBrush="#E5E5E7" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Text="Moi / phan cong" Foreground="#86868B" FontSize="12"/><TextBlock x:Name="NewValue" Text="0" Foreground="#1D1D1F" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Can tiep nhan" Foreground="#B06A18" FontSize="11"/></StackPanel></Border>
            <Border Grid.Column="2" Margin="8,0" Padding="18" Background="#FFFFFF" BorderBrush="#E5E5E7" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Text="Dang thuc hien" Foreground="#86868B" FontSize="12"/><TextBlock x:Name="InProgressValue" Text="0" Foreground="#1D1D1F" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Dang xu ly" Foreground="#34785A" FontSize="11"/></StackPanel></Border>
            <Border Grid.Column="3" Margin="8,0" Padding="18" Background="#FFFFFF" BorderBrush="#E5E5E7" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Text="Tam ngung" Foreground="#86868B" FontSize="12"/><TextBlock x:Name="PausedValue" Text="0" Foreground="#1D1D1F" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Dang cho" Foreground="#956400" FontSize="11"/></StackPanel></Border>
            <Border Grid.Column="4" Margin="8,0" Padding="18" Background="#FFFFFF" BorderBrush="#E5E5E7" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Text="Hoan thanh / dong" Foreground="#86868B" FontSize="12"/><TextBlock x:Name="ClosedValue" Text="0" Foreground="#1D1D1F" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Da xu ly" Foreground="#6E6E73" FontSize="11"/></StackPanel></Border>
            <Border Grid.Column="5" Margin="8,0,0,0" Padding="18" Background="#FFF8E8" BorderBrush="#F0DFC0" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Text="SLA can chu y" Foreground="#956400" FontSize="12"/><TextBlock x:Name="SlaValue" Text="0" Foreground="#6B4700" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Sap han / qua han" Foreground="#956400" FontSize="11"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="16,6,16,12"><Border Background="White" BorderBrush="#DEDEE2" BorderThickness="1" CornerRadius="12"><wv2:WebView2 x:Name="FtmsWebView" NavigationCompleted="OnNavigationCompleted"/></Border></Grid>
        <Border Grid.Row="3" Background="#1D1D1F"><Grid Margin="18,0"><TextBlock x:Name="MonitorText" Text="Dang khoi tao bo theo doi" Foreground="#D2D2D7" VerticalAlignment="Center" FontSize="11"/><TextBlock Text="REALTIME + AUTO REFRESH" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/></Grid></Border>
    </Grid>
</Window>
