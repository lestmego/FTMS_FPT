<Window x:Class="FTMS.Desktop.CompactWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FTMS Companion" Icon="pack://application:,,,/ftms-app.ico" Width="1280" Height="760" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#F5F5F7" FontFamily="Segoe UI Variable Display" PreviewMouseMove="OnUserActivity" PreviewKeyDown="OnUserActivity">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E1E1E5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTipService.ShowDuration" Value="5000"/></Style>
        <Style x:Key="ChartValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1D1D1F"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
        <Style x:Key="ChartLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="Foreground" Value="#6E6E73"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <wv2:WebView2 x:Name="MonitorWebView" Width="1" Height="1" IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="-1"/>
        <Border Background="#FBFBFD" BorderBrush="#E1E1E5" BorderThickness="0,0,0,1">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="Trang FTMS" Click="OpenFtms"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="16" Foreground="#1D1D1F"/></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Tải lại danh sách" Click="ReloadFtms"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="16" Foreground="#1D1D1F"/></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Cài đặt" Click="OpenSettings"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16" Foreground="#1D1D1F"/></Button>
                    <Border Margin="8,0,0,0" Padding="10,6" Background="#EEF4F0" CornerRadius="6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#D9A441" Margin="0,0,7,0"/><TextBlock x:Name="SessionText" Text="Đang kết nối" FontSize="11" Foreground="#53605B"/></StackPanel></Border>
                </StackPanel>
                <Border Grid.Column="2" Width="540" Height="58" Padding="10,6" Background="#FFFFFF" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="8"/></Grid.RowDefinitions>
                            <UniformGrid Columns="4">
                                <StackPanel><TextBlock x:Name="NewValue" Text="0" Style="{StaticResource ChartValue}"/><TextBlock Text="Mới / Phân công" Style="{StaticResource ChartLabel}"/></StackPanel>
                                <StackPanel><TextBlock x:Name="InProgressValue" Text="0" Style="{StaticResource ChartValue}"/><TextBlock Text="Đang thực hiện" Style="{StaticResource ChartLabel}"/></StackPanel>
                                <StackPanel><TextBlock x:Name="PausedValue" Text="0" Style="{StaticResource ChartValue}"/><TextBlock Text="Tạm ngưng" Style="{StaticResource ChartLabel}"/></StackPanel>
                                <StackPanel><TextBlock x:Name="ClosedValue" Text="0" Style="{StaticResource ChartValue}"/><TextBlock Text="Hoàn thành" Style="{StaticResource ChartLabel}"/></StackPanel>
                            </UniformGrid>
                            <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Background="#ECECF0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="NewChartColumn" Width="1*"/><ColumnDefinition x:Name="InProgressChartColumn" Width="1*"/><ColumnDefinition x:Name="PausedChartColumn" Width="1*"/><ColumnDefinition x:Name="ClosedChartColumn" Width="1*"/></Grid.ColumnDefinitions>
                                    <Border Background="#4A8FE7"/><Border Grid.Column="1" Background="#55A878"/><Border Grid.Column="2" Background="#D6A53A"/><Border Grid.Column="3" Background="#8E8E93"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Column="1" Margin="10,0,0,0" Padding="7,3" Background="#FDEBEC" CornerRadius="6">
                            <StackPanel HorizontalAlignment="Center"><TextBlock Text="Cảnh báo SLA" FontSize="9" Foreground="#A33B3B"/><TextBlock x:Name="SlaValue" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#8E2726" HorizontalAlignment="Center"/></StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="10"><Border Background="White" BorderBrush="#DEDEE2" BorderThickness="1" CornerRadius="8"><wv2:WebView2 x:Name="FtmsWebView" NavigationCompleted="OnNavigationCompleted"/></Border></Grid>
        <Border Grid.Row="2" Background="#1D1D1F"><Grid Margin="14,0"><TextBlock x:Name="MonitorText" Text="Đang khởi tạo" Foreground="#D2D2D7" VerticalAlignment="Center" FontSize="10"/><TextBlock Text="THỜI GIAN THỰC + TỰ ĐỘNG LÀM MỚI" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9"/></Grid></Border>
    </Grid>
</Window>
