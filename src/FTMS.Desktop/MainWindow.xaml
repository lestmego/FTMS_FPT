<Window x:Class="FTMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FTMS Companion" Height="820" Width="1440" MinHeight="680" MinWidth="1100"
        Background="#EEF2F5" FontFamily="Segoe UI" PreviewMouseMove="OnUserActivity" PreviewKeyDown="OnUserActivity">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#102C3C">
            <Grid Margin="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="FTMS" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="COMPANION / OPERATIONS" Foreground="#77C7B5" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
                <Border Grid.Row="1" Margin="0,28,0,20" Padding="16" Background="#183C4D" CornerRadius="4">
                    <StackPanel><TextBlock Text="MONITOR STATUS" Foreground="#8CB8C5" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MonitorStatusText" Text="Dang khoi tao" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="White" FontSize="14"/></StackPanel>
                </Border>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="CAU HINH" Foreground="#8CB8C5" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Chu ky dong bo (giay)" Foreground="White"/><TextBox x:Name="PollIntervalText" Text="30" Margin="0,6,0,14" Padding="10"/>
                    <TextBlock Text="Telegram bot token" Foreground="White"/><PasswordBox x:Name="TelegramTokenText" Margin="0,6,0,14" Padding="10"/>
                    <TextBlock Text="Telegram chat ID" Foreground="White"/><TextBox x:Name="TelegramChatText" Margin="0,6,0,14" Padding="10"/>
                    <CheckBox x:Name="AutoRefreshCheck" Content="Tu dong dong bo" IsChecked="True" Foreground="White" Margin="0,6,0,18"/>
                    <WrapPanel><Button Content="BAT THEO DOI" Click="StartMonitoring" Padding="16,10" Margin="0,0,8,8" Background="#21A179" Foreground="White" BorderThickness="0"/>
                        <Button Content="DUNG" Click="StopMonitoring" Padding="16,10" Margin="0,0,0,8" Background="#D05B4F" Foreground="White" BorderThickness="0"/></WrapPanel>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Email moi nhat duoc dinh kem moi su kien thay doi trang thai." TextWrapping="Wrap" Foreground="#8CB8C5" FontSize="11"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="14" Background="White" BorderBrush="#D7E0E5" BorderThickness="1" Margin="0,0,0,12">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="FTMS" Click="OpenFtms" Padding="18,8" Margin="0,0,8,0"/><Button Content="Dang nhap lai" Click="RecoverLogin" Padding="18,8" Margin="0,0,8,0"/><Button Content="Tai lai" Click="ReloadFtms" Padding="18,8"/>
                </StackPanel><TextBlock x:Name="SessionStatusText" Text="Session: dang kiem tra" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#486270"/></DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="#D7E0E5" BorderThickness="1"><wv2:WebView2 x:Name="FtmsWebView" NavigationCompleted="OnNavigationCompleted"/></Border>
        </Grid>
    </Grid>
</Window>
